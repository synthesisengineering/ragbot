# Ragbot environment configuration template.
# Copy to .env and edit. Docker Compose reads .env automatically; for native
# CLI use, source it via `set -a; . .env; set +a` before running ragbot.

# --- Postgres / pgvector backend -----------------------------------------
# Used by docker-compose's `postgres` service AND the pgvector backend.
# Change the password before any non-local use.
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=ragbot_dev_password_change_me

# Two roles, two purposes — see docs/rls-and-roles.md for the full story.
#
# `ragbot` (POSTGRES_USER above) is a Postgres SUPERUSER (the official
# postgres/pgvector docker images always make POSTGRES_USER one). Postgres
# unconditionally disables row-level security for superusers — no setting
# overrides this — so this role must be used ONLY for applying migrations
# (RAGBOT_MIGRATION_DATABASE_URL below), never for the app's own runtime
# queries. Serving real traffic through it would make the RLS hardening on
# documents/chunks (migration 0003_content_tiers.sql) a silent no-op.
#
# `ragbot_app` is a restricted, non-superuser, non-bypassrls role that
# migration 0003 creates idempotently, with exactly the SELECT/INSERT/
# UPDATE/DELETE privileges the app's runtime queries need. Its password is
# provisioned from RAGBOT_APP_DB_PASSWORD the first time migrations run.
RAGBOT_APP_DB_PASSWORD=ragbot_app_dev_password_change_me

# Application runtime DSN — everything the app queries at request time
# (search/upsert/memory reads-writes). Points at the restricted `ragbot_app`
# role, not the superuser.
# Inside docker-compose the host is `postgres`; from the host machine use
# `localhost:5433` (the bound port from docker-compose.yml).
RAGBOT_DATABASE_URL=postgresql://ragbot_app:ragbot_app_dev_password_change_me@postgres:5432/ragbot
# RAGBOT_DATABASE_URL=postgresql://ragbot_app:ragbot_app_dev_password_change_me@localhost:5433/ragbot  # native CLI

# Elevated DSN used ONLY to apply migrations (CREATE ROLE, ALTER TABLE ...
# ENABLE/FORCE ROW LEVEL SECURITY, CREATE EXTENSION, schema-level GRANTs).
# Falls back to RAGBOT_DATABASE_URL when unset, which is required on a
# brand-new database (nothing else can create `ragbot_app` for the first
# time) — but once both roles exist, keep this pointed at the superuser
# role and RAGBOT_DATABASE_URL pointed at ragbot_app.
RAGBOT_MIGRATION_DATABASE_URL=postgresql://ragbot:ragbot_dev_password_change_me@postgres:5432/ragbot
# RAGBOT_MIGRATION_DATABASE_URL=postgresql://ragbot:ragbot_dev_password_change_me@localhost:5433/ragbot  # native CLI

# --- Demo mode (v3.2+) ---------------------------------------------------
# Set to 1 to use the bundled demo workspace + skill (in `demo/`) and
# hard-isolate discovery from any real workspaces on the host. The Web UI
# renders a banner; /health and /api/config report demo_mode: true.
# Equivalent to running `ragbot --demo`.
# RAGBOT_DEMO=1

# --- LLM backend selection (v3.1+) ---------------------------------------
# litellm (default; broad provider coverage) | direct (Anthropic + OpenAI +
# google-genai SDKs called directly, no third-party gateway).
RAGBOT_LLM_BACKEND=litellm

# --- Vector backend selection --------------------------------------------
# pgvector (default) | qdrant
RAGBOT_VECTOR_BACKEND=pgvector

# --- Qdrant fallback (when RAGBOT_VECTOR_BACKEND=qdrant) -----------------
# Embedded local-file mode is used when QDRANT_URL is unset.
# QDRANT_URL=http://qdrant:6333
QDRANT_PATH=/app/qdrant_data

# --- Discovery -----------------------------------------------------------
# Optional override. Unset by default; ragbot reads ~/.synthesis/console.yaml
# and ~/workspaces/*/ai-knowledge-* automatically.
# RAGBOT_BASE_PATH=/path/to/ai-knowledge

# Owner-context flag: set to 1 to expose -private repos in discovery.
# RAGBOT_OWNER_CONTEXT=1

# --- Embedding model ------------------------------------------------------
# Override the sentence-transformers model. Default: all-MiniLM-L6-v2 (384-dim).
# Changing this requires a full re-index (existing rows tag the model used).
# EMBEDDING_MODEL=all-MiniLM-L6-v2
